# ============================================================
# AI Platform - Staging Environment Variables Template
# ============================================================
# Copy to .env.staging and fill in real values.
# NEVER commit real secrets to version control!

# ──────────────────────────────────────────────
# CLOUDFLARE
# ──────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cf-api-token"

# ──────────────────────────────────────────────
# DATABASE (Cloudflare D1)
# ──────────────────────────────────────────────
// No DSN needed - D1 uses wrangler.toml bindings
// For staging: ensure the D1 database_id in wrangler.toml points to staging DB

# ──────────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────────
// JWT signing secret (use different value from production)
JWT_SECRET="staging-jwt-secret-generate-with-node-crypto-randomBytes48"
// WeChat OAuth (optional for staging)
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
// GitHub OAuth (optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ──────────────────────────────────────────────
# AI PROVIDERS
# ──────────────────────────────────────────────
// Use mock provider if no API keys available
DEFAULT_AI_PROVIDER="mock"
FALLBACK_AI_PROVIDERS="mock"
OPENAI_API_KEY="sk-staging-openai-key"
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
DEEPSEEK_API_KEY=""
// Task execution limits (milliseconds)
TASK_EXECUTION_TIMEOUT_MS="60000"
STALE_RUNNING_MS="300000"
MAX_QUEUE_WORKERS="2"

# ──────────────────────────────────────────────
# STORAGE (Cloudflare R2)
# ──────────────────────────────────────────────
// R2 bucket configured via wrangler.toml binding: ASSETS_BUCKET
// Staging may use a separate R2 bucket with different name

# ──────────────────────────────────────────────
# PAYMENT (Stripe - test mode)
# ──────────────────────────────────────────────
// Stripe test mode keys - never use live keys in staging
STRIPE_SECRET_KEY="sk_test_staging_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_staging_placeholder"
STRIPE_MODE="test"

# ──────────────────────────────────────────────
# LOGGING & MONITORING
# ──────────────────────────────────────────────
NODE_ENV="staging"
LOG_LEVEL="info"
// Sentry DSN (optional — use staging project DSN)
SENTRY_DSN=""

# ──────────────────────────────────────────────
# ADMIN
# ──────────────────────────────────────────────
// Admin-only API key (different from production)
ADMIN_API_KEY="admin-staging-key-change-me"
// Frontend API base URL (staging domain)
VITE_API_BASE="https://api-staging.your-domain.com"

# Frontend Vite env variables
VITE_APP_NAME="AI Platform (Staging)"
VITE_APP_VERSION="0.1.0-staging"
VITE_IS_STAGING="true"