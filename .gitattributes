# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted to native line endings on checkout.
*.js eol=lf
*.ts eol=lf
*.tsx eol=lf
*.jsx eol=lf
*.json eol=lf
*.css eol=lf
*.html eol=lf
*.md eol=lf
*.sql eol=lf
*.toml eol=lf
*.yaml eol=lf
*.yml eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff2 binary
*.ttf binary
*.woff binary
*.eot binary