# ============================================================
# AI Platform — Environment Variables Template
# ============================================================
# Copy this file to .env.local for local development,
# or to your Cloudflare Pages environment variables for deployment.
#
# NEVER commit real secrets to version control!
# ============================================================

# ──────────────────────────────────────────────
# CLOUDFLARE
# ──────────────────────────────────────────────
# Required for wrangler CLI authentication
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_API_TOKEN=your-api-token-here

# ──────────────────────────────────────────────
# DATABASE (Cloudflare D1)
# ──────────────────────────────────────────────
# D1 is configured via wrangler.toml bindings.
# For local dev with Wrangler:
#   wrangler d1 execute ai-platform-db --command="SELECT 1"
# No DSN needed for D1.

# ──────────────────────────────────────────────
# AUTHENTICATION
# ──────────────────────────────────────────────
# JWT / session signing secret (generate with:)
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-64-char-random-string

# WeChat OAuth (for Chinese market login)
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# GitHub OAuth (optional fallback login)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ──────────────────────────────────────────────
# AI PROVIDERS
# ──────────────────────────────────────────────
# Default and fallback providers (comma-separated)
DEFAULT_AI_PROVIDER=openai
FALLBACK_AI_PROVIDERS=anthropic,gemini,deepseek

# OpenAI
OPENAI_API_KEY=sk-placeholder-openai-key

# Anthropic
ANTHROPIC_API_KEY=sk-placeholder-anthropic-key

# Google Gemini
GOOGLE_AI_API_KEY=sk-placeholder-google-ai-key

# DeepSeek
DEEPSEEK_API_KEY=sk-placeholder-deepseek-key

# Task execution limits (milliseconds)
TASK_EXECUTION_TIMEOUT_MS=300000
STALE_RUNNING_MS=7200000
MAX_QUEUE_WORKERS=4

# ──────────────────────────────────────────────
# STORAGE (Cloudflare R2)
# ──────────────────────────────────────────────
# R2 bucket configured via wrangler.toml binding: ASSETS_BUCKET
# No credential needed — uses Cloudflare IAM auth.

# ──────────────────────────────────────────────
# PAYMENT
# ──────────────────────────────────────────────
# Stripe (placeholder for future integration)
STRIPE_SECRET_KEY=sk_placeholder_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# ──────────────────────────────────────────────
# LOGGING & MONITORING
# ──────────────────────────────────────────────
# Set to "production" in deployed env
NODE_ENV=development

# Sentry DSN (optional — fill when ready)
SENTRY_DSN=

# ──────────────────────────────────────────────
# ADMIN
# ──────────────────────────────────────────────
# Admin-only API key (for programmatic access to /admin/* endpoints)
ADMIN_API_KEY=admin_placeholder_key_change_me

# Frontend API base URL
VITE_API_BASE=https://api.your-domain.com
