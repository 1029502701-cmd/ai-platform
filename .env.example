# ============================================================
# .env.example
# ============================================================
# Copy to .env.production for local Cloudflare Pages development.
# Values here are placeholders — replace with real keys before production use.
# NEVER commit real secrets to git.
# ============================================================

# Cloudflare Account & API Token (needed by wrangler deploy)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# AI Provider Keys
OPENAI_API_KEY=sk-placeholder-openai-key
ANTHROPIC_API_KEY=sk-placeholder-anthropic-key
GOOGLE_AI_API_KEY=sk-placeholder-google-key
DEEPSEEK_API_KEY=sk-placeholder-deepseek-key

# JWT / Session Secret (generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-strong-random-string

# AI Provider Selection
DEFAULT_AI_PROVIDER=openai
FALLBACK_AI_PROVIDERS=anthropic,gemini,deepseek

# Frontend API Base URL (set in Vite build)
VITE_API_BASE=https://api.your-domain.com
